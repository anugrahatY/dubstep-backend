# Copy this file to backend/.env and set your Groq key.
GROQ_API_KEY=replace-with-your-groq-api-key
# Optional; defaults to openai/gpt-oss-120b.
# GROQ_MODEL=openai/gpt-oss-120b

# Set this to the deployed frontend origin when hosting the frontend separately.
# Multiple comma-separated origins are supported.
# CORS_ORIGINS=https://your-project.vercel.app

# Optional OpenAI provider; defaults to gpt-6-luna.
# OPENAI_API_KEY=replace-with-your-openai-api-key
# OPENAI_MODEL=gpt-6-luna

# Optional local Dubstep model adapter. Point this to a directory containing
# adapter_config.json and adapter_model.safetensors.
# MODEL_DIR=drive-download-20261024T090318Z-1-001/checkpoint-500
